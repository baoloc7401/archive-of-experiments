{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "yarn: dev",
      "type": "shell",
      "command": "yarn run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready|compiled|localhost"
        }
      }
    }
  ]
}