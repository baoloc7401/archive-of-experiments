{"nodes": [{"id": "reaction_diffusion_textbook_grayscottmodel", "label": "Gray-Scott reaction-diffusion model (U, V, feed/kill equations)", "file_type": "concept", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_seedasymmetryfinding", "label": "Headline finding: opposite seeds for the two regime families", "file_type": "rationale", "rationale": "Which Gray-Scott pattern you get is set as much by the seed as by feed/kill; low-feed regimes need small nuclei, high-feed regimes need large ones; no single initial condition brings all presets to life. The equation itself was never the bug.", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_gpupingpong", "label": "GPU ping-pong float-texture simulation architecture", "file_type": "concept", "rationale": "Stateful ping-pong between two RG32F textures across five fragment passes (sim, splat, seed, display, copy, rescale), drawn as a full-screen triangle; React never touches a pixel.", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_float32fix", "label": "Float16 to float32 precision fix (RG16F to RG32F)", "file_type": "rationale", "rationale": "RG16F has ~3 significant digits so tiny per-step increments near U~1 round away, killing delicate high-kill regimes; switching to RG32F revived them, needing EXT_color_buffer_float and OES_texture_float_linear, with RG16F as fallback.", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_resizebug", "label": "resize() re-seed bug masquerading as always-near-empty", "file_type": "rationale", "rationale": "resize() used to re-seed the grid on every canvas size change; ResizeObserver fires repeatedly during layout, wiping the developing field each time. Fixed by preserving the field via a rescale-blit and only seeding on first allocation or explicit reset.", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_seedingresearch", "label": "Seeding research: jittered grid of mixed-size hard-cored nuclei", "file_type": "rationale", "rationale": "Progression: flooding V acted as an eraser; a sane nucleus still had opposite size needs per regime family; the final seed uses a jittered grid (not random), mixed sizes (radius 6 and 18), and a hard core (uInner=0.8) rather than a soft dome, giving all eight presets 33-98% fill reliably across reloads.", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_verificationmethodology", "label": "Verification methodology: CPU reference + live GPU oracle + debug panel", "file_type": "concept", "rationale": "For a GPU sim, expose the engine's aggregate state as text and measure pixels; never conclude from a screenshot, never trust an offline model over the live device on a marginal case.", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_simulationts", "label": "simulation.ts (GPU engine)", "file_type": "code", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_shadersts", "label": "shaders.ts (GLSL passes, SIM_FS / SPLAT_FS)", "file_type": "code", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_grayscotttestts", "label": "grayscott.test.ts (CPU reference + smoke tests)", "file_type": "code", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_presetsts", "label": "presets.ts (eight f/k presets: spots, solitons, maze, mitosis, fingerprint, coral, worms, u-skate)", "file_type": "code", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_turingmorphogenesis", "label": "Turing's morphogenesis (1952)", "file_type": "concept", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_pearsonclassification", "label": "Pearson's classification (1993) of the Gray-Scott (f,k) plane", "file_type": "concept", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reaction_diffusion_textbook_karlsimstutorial", "label": "Karl Sims' Gray-Scott tutorial convention (Du=1, Dv=0.5)", "file_type": "concept", "source_file": "docs/reaction-diffusion/TEXTBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "reaction_diffusion_textbook_verificationmethodology", "target": "verify_experiment_skill_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/reaction-diffusion/TEXTBOOK.